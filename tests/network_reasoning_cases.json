          "raw": "interfaces {\n xe-0/0/0 {\n  mtu 9216;\n  unit 100 {\n   family inet {\n    ## inherited from group BASE-L3\n    mtu 1500;\n    address 192.0.2.1/30;\n   }\n  }\n }\n}\nPE-J>",
          "expected_status": "SUCCESS"
