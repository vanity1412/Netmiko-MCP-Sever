{
  "synthetic": true,
  "cases": [
    {
      "id": "wrong_vrf",
      "question": "BLUE client 192.0.2.10 cannot reach 198.51.100.10. Does the global route prove reachability?",
      "evidence": [
        {
          "id": "wrong_vrf-e1",
          "target": "PE-A",
          "device_type": "cisco_ios",
          "command": "show running-config interface GigabitEthernet0/1",
          "captured_at": "2026-11-17T09:00:00+07:00",
          "raw": "interface GigabitEthernet0/1\n vrf forwarding BLUE\n ip address 192.0.2.1 255.255.255.0\nPE-A#",
          "expected_status": "SUCCESS"
        },
        {
          "id": "wrong_vrf-e2",
          "target": "PE-A",
          "device_type": "cisco_ios",
          "command": "show ip route 198.51.100.10",
          "captured_at": "2026-11-17T09:00:00+07:00",
          "raw": "Routing entry for 198.51.100.0/24\n Known via static\n * 203.0.113.2\nPE-A#",
          "expected_status": "SUCCESS"
        },
        {
          "id": "wrong_vrf-e3",
          "target": "PE-A",
          "device_type": "cisco_ios",
          "command": "show ip route vrf BLUE 198.51.100.10",
          "captured_at": "2026-11-17T09:00:00+07:00",
          "raw": "Routing Table: BLUE\n% Network not in table\nPE-A#",
          "expected_status": "SUCCESS"
        }
      ]
    },
    {
      "id": "healthy",
      "question": "Same BLUE client/destination. Must a static route be added because BLUE has no /24?",
      "evidence": [
        {
          "id": "healthy-e1",
          "target": "PE-A",
          "device_type": "cisco_ios",
          "command": "show ip route vrf BLUE 198.51.100.10",
          "captured_at": "2026-11-17T09:00:00+07:00",
          "raw": "Routing Table: BLUE\nRouting entry for 0.0.0.0/0\n * 203.0.113.2\nPE-A#",
          "expected_status": "SUCCESS"
        },
        {
          "id": "healthy-e2",
          "target": "PE-A",
          "device_type": "cisco_ios",
          "command": "show ip cef vrf BLUE exact-route 192.0.2.10 198.51.100.10",
          "captured_at": "2026-11-17T09:00:00+07:00",
          "raw": "192.0.2.10 -> 198.51.100.10 : GigabitEthernet0/2 (203.0.113.2)\nPE-A#",
          "expected_status": "SUCCESS"
        },
        {
          "id": "healthy-e3",
          "target": "PE-A",
          "device_type": "cisco_ios",
          "command": "show interfaces GigabitEthernet0/2",
          "captured_at": "2026-11-17T09:00:00+07:00",
          "raw": "GigabitEthernet0/2 is up, line protocol is up\nPE-A#",
          "expected_status": "SUCCESS"
        }
      ]
    },
    {
      "id": "missing",
      "question": "No RT found in this configuration response. Can BLUE be declared to have no RT?",
      "evidence": [
        {
          "id": "missing-e1",
          "target": "PE-J",
          "device_type": "juniper_junos",
          "command": "show configuration routing-instances BLUE",
          "captured_at": "2026-11-17T09:00:00+07:00",
          "raw": "routing-instances {\n BLUE {\n  instance-type vrf;\n",
          "expected_status": "PARTIAL"
        },
        {
          "id": "missing-e2",
          "target": "PE-J",
          "device_type": "juniper_junos",
