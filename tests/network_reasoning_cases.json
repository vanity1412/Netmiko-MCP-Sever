          "raw": "error: permission denied\nPE-J>",
          "expected_status": "CLI_ERROR"
        }
      ]
    },
    {
      "id": "asymmetry",
      "question": "HTTPS fails for 192.0.2.10:50000 -> 198.51.100.10:443 in BLUE. Is a new route required?",
      "evidence": [
        {
          "id": "asymmetry-e1",
          "target": "FW-A",
          "device_type": "linux",
          "command": "ip vrf exec BLUE ip route get 198.51.100.10 from 192.0.2.10",
          "captured_at": "2026-11-17T09:00:00+07:00",
          "raw": "198.51.100.10 from 192.0.2.10 via 203.0.113.1 dev eth1\nFW-A#",
          "expected_status": "SUCCESS"
        },
        {
          "id": "asymmetry-e2",
          "target": "EDGE",
          "device_type": "cisco_ios",
          "command": "show ip cef vrf BLUE exact-route 198.51.100.10 192.0.2.10",
          "captured_at": "2026-11-17T09:00:00+07:00",
          "raw": "198.51.100.10 -> 192.0.2.10 : GigabitEthernet0/3 (203.0.113.6)\nEDGE#",
          "expected_status": "SUCCESS"
        },
        {
          "id": "asymmetry-e3",
          "target": "EDGE",
          "device_type": "cisco_ios",
          "command": "show lldp neighbors detail",
          "captured_at": "2026-11-17T09:00:00+07:00",
          "raw": "Local Intf: Gi0/3\nSystem Name: FW-B\nManagement Address: 192.0.2.202\nEDGE#",
          "expected_status": "SUCCESS"
        },
        {
          "id": "asymmetry-e4",
          "target": "FW-B",
          "device_type": "linux",
          "command": "cat /var/log/fixture-flow",
          "captured_at": "2026-11-17T09:00:00+07:00",
          "raw": "2026-11-17T09:00:00+07:00 vrf=BLUE tcp 198.51.100.10:443 -> 192.0.2.10:50000 SYN-ACK drop=no-session nat=none\nFW-B#",
          "expected_status": "SUCCESS"
        },
        {
          "id": "asymmetry-e5",
          "target": "FW-A",
          "device_type": "linux",
          "command": "cat /run/fixture-session",
          "captured_at": "2026-11-17T09:00:00+07:00",
          "raw": "vrf=BLUE tcp 192.0.2.10:50000 -> 198.51.100.10:443 state=SYN-SENT nat=none owner=FW-A\nFW-A#",
          "expected_status": "SUCCESS"
        }
      ]
    },
    {
